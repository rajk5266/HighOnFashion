---
import { optimizedImage } from "../utils/image";

type CollectionColor = "purple" | "orange" | "blue" | "green";

interface FeaturedCollection {
  id: string;
  name: string;
  cardImage: string;
  alt: string;
  season: string;
  color: CollectionColor;
}

const { collections } = Astro.props as {
  collections: FeaturedCollection[];
};

// Display widths: large cards ~1100px, split cards ~640px. Serve 2x for retina.
const largeSrc = (src: string) => optimizedImage(src, { w: 1200, q: 72 });
const splitSrc = (src: string) => optimizedImage(src, { w: 800, q: 72 });
---

<section class="max-w-7xl mx-auto px-6 py-12">
  <div class="mb-12">
    <h2 class="text-3xl font-serif mb-2">Special Collections</h2>
    <p class="text-neutral-500">Curated drops with a distinct identity</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- LEFT LARGE -->
    <a
      href={`/collection/${collections[0].id}`}
      class="relative h-[420px] lg:h-[520px] group overflow-hidden"
    >
      <img
        src={largeSrc(collections[0].cardImage)}
        alt={collections[0].alt}
        width="1200"
        height="1600"
        loading="lazy"
        decoding="async"
        sizes="(min-width: 1024px) 33vw, 100vw"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />

      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/80"
      >
      </div>

      <div class="absolute bottom-6 left-6 text-white">
        <p class="text-xs uppercase tracking-widest mb-1">
          {collections[0].season}
        </p>
        <h3 class="text-2xl font-serif text-white">
          {collections[0].name}
        </h3>
      </div>
    </a>

    <!-- MIDDLE SPLIT -->
    <div class="grid gap-6 lg:grid-rows-2">
      {
        collections.slice(1, 3).map((collection) => (
          <a
            href={`/collection/${collection.id}`}
            class="relative h-[220px] sm:h-[260px] lg:h-auto group overflow-hidden"
          >
            <img
              src={splitSrc(collection.cardImage)}
              alt={collection.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              sizes="(min-width: 1024px) 33vw, 100vw"
              class="absolute inset-0 w-full h-full object-cover object-[center_30%] transition-transform duration-700 group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/80" />

            <div class="absolute bottom-4 left-4 text-white">
              <p class="text-xs uppercase tracking-widest mb-1">
                {collection.season}
              </p>
              <h3 class="text-lg font-serif text-white">{collection.name}</h3>
            </div>
          </a>
        ))
      }
    </div>

    <!-- RIGHT LARGE -->
    <a
      href={`/collection/${collections[3].id}`}
      class="relative h-[420px] lg:h-[520px] group overflow-hidden"
    >
      <img
        src={largeSrc(collections[3].cardImage)}
        alt={collections[3].alt}
        width="1200"
        height="1600"
        loading="lazy"
        decoding="async"
        sizes="(min-width: 1024px) 33vw, 100vw"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />

      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/80"
      >
      </div>

      <div class="absolute bottom-6 left-6 text-white">
        <p class="text-xs uppercase tracking-widest mb-1">
          {collections[3].season}
        </p>
        <h3 class="text-2xl font-serif text-white">
          {collections[3].name}
        </h3>
      </div>
    </a>
  </div>
</section>
