---
// src/components/HeaderAuth.astro
---

<div class="flex items-center gap-4 md:gap-6 text-black">
  <!-- Native Sign In / Profile Switch Trigger -->
  <button
    id="nav-signin-trigger"
    class="snipcart-customer-signin flex items-center gap-1.5 text-xs md:text-sm tracking-widest uppercase font-medium hover:text-gold transition-colors duration-200 cursor-pointer"
  >
    <i class="fa-regular fa-user text-base"></i>
    <span>Sign In / Account</span>
  </button>

  <!-- Sign Out Trigger -->
  <button
    id="nav-signout-trigger"
    class="snipcart-customer-signout hidden flex items-center gap-1.5 text-xs md:text-sm tracking-widest uppercase font-medium text-red-700 hover:text-red-900 transition-colors duration-200 cursor-pointer"
  >
    <i class="fa-solid fa-arrow-right-from-bracket text-base"></i>
    <span>Sign Out</span>
  </button>

  <!-- Cart Button -->
  <button
    class="snipcart-checkout flex items-center gap-2 relative p-1.5 text-xs uppercase tracking-widest font-medium hover:text-gold transition-colors duration-200 cursor-pointer"
  >
    <i class="fa-solid fa-bag-shopping text-lg"></i>
    <!-- <span
      class="snipcart-total-items absolute -top-2.5 -right-2.5 bg-gold text-forest text-[10px] font-bold w-4.5 h-4.5 rounded-full flex items-center justify-center border border-white"
      >0</span
    > -->
    <span>Cart</span>
  </button>
</div>

<script>
  function synchronizeAuthenticationEcosystem() {
    const signInBtn = document.getElementById("nav-signin-trigger");
    const signOutBtn = document.getElementById("nav-signout-trigger");

    try {
      const SnipcartGlobal = (window as any).Snipcart;
      if (
        SnipcartGlobal &&
        typeof SnipcartGlobal.store?.getState === "function"
      ) {
        const state = SnipcartGlobal.store.getState();
        const customer = state.session?.customer;
        const isSignedIn = customer && customer.status === "SignedIn";

        if (isSignedIn) {
          // Dynamic label swap: updates the native login trigger to say "My Profile" when authenticated
          if (signInBtn) {
            const textSpan = signInBtn.querySelector("span");
            if (textSpan) textSpan.textContent = "My Profile";
          }
          signOutBtn?.classList.remove("hidden");
        } else {
          if (signInBtn) {
            const textSpan = signInBtn.querySelector("span");
            if (textSpan) textSpan.textContent = "Sign In / Account";
          }
          signOutBtn?.classList.add("hidden");
        }
      }
    } catch (err) {
      console.warn("Session synchronization paused:", err);
    }
  }

  // Core Lifecycle Hooks
  document.addEventListener("snipcart.initialized", () => {
    synchronizeAuthenticationEcosystem();

    (window as any).Snipcart.events.on("customer.session.changed", () => {
      synchronizeAuthenticationEcosystem();
    });
  });

  // Init setups on standard load and Astro client-side layout swaps
  document.addEventListener("DOMContentLoaded", () => {
    synchronizeAuthenticationEcosystem();
  });

  document.addEventListener("astro:after-swap", () => {
    synchronizeAuthenticationEcosystem();
  });

  // Instant execution fallback if the SDK script beat the DOM listeners
  if ((window as any).Snipcart) {
    synchronizeAuthenticationEcosystem();
  }
</script>
