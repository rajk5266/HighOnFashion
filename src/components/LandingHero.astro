---
import { Image } from "astro:assets";

import heroBg from "../assets/hof_banner.webp";
import heroBg1 from "../assets/highonfashion-herobanner-1.webp"
import heromobile from "../assets/hof_banner_mobile.webp";
---

<!-- Hero Section -->
<section
  class="relative w-full min-h-[400px] lg:min-h-[600px] overflow-hidden flex items-center justify-center"
>
<div class="absolute inset-0 z-0">
  <!-- Desktop Image -->
  <Image
    src={heroBg}
    alt="High fashion editorial shot of models in vintage clothing"
    class="hidden md:block w-full h-full object-cover object-top"
    widths={[960, 1440, 1920]}
    sizes="100vw"
    quality={75}
    priority
  />

  <!-- Mobile Image -->
  <Image
    src={heromobile}
    alt="High fashion editorial shot of models in vintage clothing"
    class="block md:hidden w-full h-[400px] object-cover object-center"
    widths={[480, 768, 1080]}
    sizes="100vw"
    quality={70}
    priority
  />

  <!-- Overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-white/20 via-black/20 to-black/70"
  ></div>
</div>

  <div
    class="relative z-10 text-center text-[#F9F9F5] px-6 max-w-4xl mx-auto mt-20"
  >
    <!-- <p
      class="text-sm tracking-[0.2em] uppercase mb-6 opacity-90 animate-fade-in-up"
    >
      Est. 2025 — Curated Vintage
    </p> -->

    <!-- <h1
      class="font-serif text-5xl md:text-7xl lg:text-8xl leading-none mb-8 animate-fade-in-up delay-100"
    >
      Rethink.<br />
      <span class="italic font-light">Rewear.</span><br />
      Repeat.
    </h1> -->

    <div class="animate-fade-in-up delay-200">
      <a
        href="/collections"
        class="inline-block border border-[#F9F9F5] px-8 py-3 hover:bg-[#F9F9F5] hover:text-[#1A2F23] transition-colors uppercase tracking-widest text-sm"
      >
        View the Drop
      </a>
    </div>
  </div>
</section>
