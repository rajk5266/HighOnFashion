---
// src/components/AddToCartButton.astro
interface Props {
    id: string;
    name: string;
    price: number;
    image: string;
    description?: string;
    slug: string; // The URL path to this specific item page
}

const { id, name, price, image, description = "", slug } = Astro.props;

// Snipcart's crawler runs server-side and needs a full absolute URL to validate products.
// Using Astro.url ensures the correct domain is used in every environment
// (ngrok, localhost, Vercel production, custom domain).
const currentUrl = new URL(`/products/${slug}`, Astro.url).href;
---

<button
    class="snipcart-add-item w-full py-3 bg-neutral-900 text-white font-medium text-xs uppercase tracking-widest hover:bg-gold hover:text-forest transition-colors duration-300 rounded-md shadow-sm cursor-pointer"
    data-item-id={id}
    data-item-name={name}
    data-item-price={price}
    data-item-url={currentUrl}
    data-item-image={image}
    data-item-description={description}
>
    Add to Bag
</button>
