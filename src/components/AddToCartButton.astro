---
// src/components/AddToCartButton.astro

import type { Product } from "../types/product";
import { publicUrl } from "../utils/publicUrl";


interface Props {
    product: Product;
}

const { product } = Astro.props;

// Snipcart crawler needs an absolute HTTPS URL matching /product/[slug].
const currentUrl = publicUrl(`/product/${product.slug}`, Astro.url, Astro.request);
---

<button
    class="snipcart-add-item w-full py-3 bg-neutral-900 text-white font-medium text-xs uppercase tracking-widest hover:bg-gold hover:text-forest transition-colors duration-300 rounded-md shadow-sm cursor-pointer"
    data-item-id={product.id}
    data-item-name={product.title}
    data-item-price={product.price}
    data-item-url={currentUrl}
    data-item-image={product.images.main}
    data-item-description={product.condition.description}
>
    Add to Cart
</button>
