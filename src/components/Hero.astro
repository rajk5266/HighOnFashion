---
import { Image } from "astro:assets";

const { heroImage, heading, tagline, imageAlt } = Astro.props;
---

<section
  class="relative h-[260px] md:h-[420px] w-full overflow-hidden flex items-center justify-center"
  aria-label="Page banner"
>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt={imageAlt}
      class="w-full h-full object-cover object-[center_10%]"
      priority
    />
  </div>

  
  <!-- Dark Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/40 to-black/40 pointer-events-none"></div>

  <!-- Content -->
  <div class="relative text-center px-6 max-w-4xl mx-auto z-10">
    <h1 class="font-serif text-white text-3xl md:text-5xl lg:text-6xl leading-tight mb-3">
      {heading}
    </h1>

    {tagline && (
      <p class="text-white/90 text-sm md:text-base max-w-2xl mx-auto">
        {tagline}
      </p>
    )}
  </div>
</section>