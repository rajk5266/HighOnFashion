---

---

<footer class="bg-[#1A2F23] text-[#F9F9F5] py-20 px-6 md:px-12">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
    <div class="col-span-1 md:col-span-2">
      <h2 class="font-serif text-4xl mb-6">HighOnFashion.</h2>
      <p class="max-w-md opacity-80 leading-relaxed">
        Curated vintage fashion for the modern editorial. Rethink. Rewear.
        Repeat. Sustainable style that doesn't compromise on aesthetic.
      </p>
    </div>

    <div>
      <h3 class="font-serif text-xl mb-6">Explore</h3>
      <ul class="space-y-4 opacity-80 text-sm tracking-wide uppercase">
        <li>
          <a href="/collections" class="hover:text-[#D4AF37] transition-colors"
            >Collection</a
          >
        </li>
        <li>
          <a href="/products" class="hover:text-[#D4AF37] transition-colors"
            >Products</a
          >
        </li>
        <li>
          <a href="/blog" class="hover:text-[#D4AF37] transition-colors">Blog</a
          >
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-serif text-xl mb-6">Connect</h3>
      <ul class="space-y-4 opacity-80 text-sm tracking-wide uppercase">
        <li>
          <a
            href="https://instagram.com/highonfashion01"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#D4AF37] transition-colors"
          >
            Instagram
          </a>
        </li>

        <!-- Facebook: Direct link to your page username or ID -->
        <li>
          <a
            href="https://facebook.com/share/1E51nNzAxC"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#D4AF37] transition-colors"
          >
            Facebook
          </a>
        </li>

        <!-- WhatsApp: Opens a direct chat with your country code + phone number -->
        <li>
          <a
            href="https://wa.me/7972499311?text=Hi%20there!%20I'm%20reaching%20out%20from%20the%20website."
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#D4AF37] transition-colors"
          >
            WhatsApp
          </a>
        </li>

        <!-- Email -->
        <li>
          <a
            href="mailto:studio@highonfashion.com"
            class="hover:text-[#D4AF37] transition-colors">
            Email Us
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div
    class="mt-20 pt-8 border-t border-[#F9F9F5]/10 flex flex-col md:flex-row justify-between items-center opacity-60 text-sm"
  >
    <p>&copy; {new Date().getFullYear()} HighOnFashion. All rights reserved.</p>

  </div>
</footer>
