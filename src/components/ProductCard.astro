---
// src/components/ProductCard.astro
import { imageUrl } from "../utils/image";

const {
  id,
  slug,
  title,
  price,
  image,
  alt = title,
  sizes = [],
  collectionId = "",
  isFirst = false,
} = Astro.props;

// Original full-res image from static.domain.com
const finalImage = imageUrl(image);

// Generate 350px WebP thumbnail on the fly via wsrv.nl (~20-30KB)
const thumbnailUrl = `https://wsrv.nl/?url=${encodeURIComponent(finalImage)}&w=350&q=75&output=webp`;

// Snipcart stable product URL
const itemUrl = collectionId
  ? new URL(`/collection/${collectionId}`, Astro.url).href
  : Astro.url.href;
---

<article
  class="group flex flex-col justify-between h-full bg-white border border-neutral-200/60 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300"
>
  <a href={`/product/${slug}`} class="block flex-1">
    <!-- IMAGE WITH LIGHTBOX TRIGGER -->
    <div
      class="relative aspect-[3/4] overflow-hidden bg-neutral-100 cursor-pointer"
    >
      <img
        src={thumbnailUrl}
        alt={alt}
        loading={isFirst ? "eager" : "lazy"}
        fetchpriority={isFirst ? "high" : "auto"}
        decoding={isFirst ? "sync" : "async"}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 product-lightbox-trigger"
        data-full-img={finalImage}
        data-title={title}
      />
    </div>

    <!-- PRODUCT TITLE & DETAILS -->
    <div class="p-4">
      <h3
        class="text-sm font-medium leading-snug text-neutral-800 hover:underline"
      >
        {title}
      </h3>
      <p class="text-sm text-neutral-500 mt-1 font-semibold">
        ₹{price}
      </p>
    </div>
  </a>
  <!-- SNIPCART BUTTON -->
<div class="p-4 pt-0">
  <button
    type="button"
    class="snipcart-add-item w-full bg-black text-white text-xs font-bold uppercase tracking-wider py-2.5 px-4 rounded-lg hover:bg-neutral-800 active:scale-95 transition"
    data-item-id={id}
    data-item-name={title}
    data-item-price={price}
    data-item-image={finalImage}
    data-item-url={itemUrl}
  >
    Add to Cart
  </button>
</div>

</article>
