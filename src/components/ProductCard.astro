---
import { imageUrl } from "../utils/image";

const {
  id,
  slug,
  title,
  price,
  image,
  alt = title,
  sizes = [],
  collectionId = "",
} = Astro.props;

const finalImage = imageUrl(image);



// Build a stable, absolute product URL for Snipcart's external crawler.
// Snipcart's server crawls this URL to verify product price — relative paths don't work.
// Using Astro.url.origin ensures correct domain in all envs (ngrok, Vercel, custom domain).
const itemUrl = collectionId
  ? new URL(`/collection/${collectionId}`, Astro.url).href
  : Astro.url.href;
---

<article
  class="group flex flex-col justify-between h-full bg-white border border-neutral-200/60 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300"
>
  <a href={`/product/${slug}`} class="cursor-pointer block">
    <div class="cursor-pointer">
      <div class="relative aspect-[3/4] overflow-hidden bg-neutral-100">
        <img
          src={finalImage}
          alt={alt}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      </div>

      <div class="p-4">
        <h3 class="text-sm font-medium leading-snug text-neutral-800">
          {title}
        </h3>
        <p class="text-sm text-neutral-500 mt-1">
          ₹{price}
        </p>
      </div>
    </div>

    <div class="p-4 pt-0">
    <button class="snipcart-add-item"
      data-item-id={id}
      data-item-name={title}
      data-item-price={price}
      data-item-image={finalImage}
      data-item-url={itemUrl}
    >
      Add to Cart
    </button>
  </div>
  </a>
</article>
