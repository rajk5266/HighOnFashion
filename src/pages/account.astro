---
// src/pages/account.astro
import Layout from "../layouts/Layout.astro";

const description =
  "Access your HighOnFashion customer portal to track order histories, update dynamic drop shipping details, and manage billing.";
---

<Layout title="Account Dashboard | HighOnFashion" description={description}>
  <section
    class="min-h-[85vh] flex items-center justify-center py-20 bg-stone-50"
  >
    <div class="w-full max-w-md mx-auto px-6 text-center">
      <!-- Studio Header -->
      <span class="text-xs uppercase tracking-[0.25em] text-gold font-semibold"
        >Your Studio</span
      >
      <h1 class="text-3xl md:text-4xl font-serif mt-2 mb-3 text-forest">
        Customer Portal
      </h1>
      <div class="h-[1px] w-12 bg-gold/60 mx-auto mb-6"></div>

      <p
        class="text-neutral-600 font-light text-sm tracking-wide leading-relaxed mb-8"
      >
        Review your curated vintage orders, trace dynamic shipping statuses, and
        manage your custom profile file details.
      </p>

      <!-- The Direct Portal Activation Hook -->
      <button
        id="open-portal-btn"
        class="snipcart-customer-signin inline-block w-full text-center px-6 py-3.5 text-xs uppercase tracking-widest font-semibold text-white bg-neutral-900 hover:bg-neutral-800 transition-colors duration-300 rounded-md shadow-sm cursor-pointer"
      >
        View Order History
      </button>

      <!-- Context Fallback Return -->
      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-neutral-400 hover:text-black transition-colors duration-200"
        >
          <i class="fa-solid fa-arrow-left text-[10px]"></i>
          Return to Storefront
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Dynamic Route Security: Force open the session sidebar if loaded unauthenticated
  function handleSecureVerification() {
    if (typeof (window as any).Snipcart !== "undefined") {
      const SnipcartGlobal = (window as any).Snipcart;
      const state = SnipcartGlobal.store.getState();
      const customer = state.session?.customer;

      // If user isn't signed in yet, fire the side modal directly on mount
      if (!customer || customer.status !== "SignedIn") {
        SnipcartGlobal.api.customer.openSigninModal();
      }
    }
  }

  document.addEventListener("snipcart.initialized", () => {
    handleSecureVerification();
  });

  if ((window as any).Snipcart) {
    handleSecureVerification();
  }
</script>
