---
// src/pages/products/index.astro
import Layout from "../../layouts/Layout.astro";
import ProductsGrid from "../../components/ProductsGrid.astro";
import FilterSidebar from "../../components/FilterSidebar.astro";

import { products } from "../../data/products";
// import { FeaturedCollections } from "../../data/collections";

// Safely extract filter lists with fallbacks
// const collections = FeaturedCollections ? FeaturedCollections.map((c) => ({ id: c.id, name: c.name })) : [];
const categories = products ? [...new Set(products.map((p) => p.category).filter(Boolean))] : [];
const sizes = products ? [...new Set(products.map((p) => p.taggedSize).filter(Boolean))] : [];
const styles = products ? [...new Set(products.flatMap((p) => p.style || []).filter(Boolean))] : [];
const brands = products ? [...new Set(products.map((p) => p.brand).filter(Boolean))] : [];
---

<Layout title="Products" description="Explore our featured thrift products">
  <!-- NAVIGATION TABS -->
  <section class="max-w-7xl mx-auto px-6 pt-16">
    <div class="flex gap-6 border-b border-neutral-200">
      <a href="/products" class="pb-3 border-b-2 border-black font-medium">
        Products
      </a>
    </div>
  </section>

  <!-- PRODUCTS & FILTERING -->
  <section class="max-w-7xl mx-auto px-6 py-12">
    <FilterSidebar
      categories={categories}
      sizes={sizes}
      styles={styles}
      brands={brands}
    >
      <ProductsGrid products={products} />
    </FilterSidebar>
  </section>
</Layout>