---
// External Razorpay checkout for Snipcart custom payment gateway.
import { Image as AstroImage } from "astro:assets";
import logo from "../assets/HOF_Color.png";
import GoogleTagManager from "../components/GoogleTagManager.astro";

const logoSrc = logo.src;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Complete Your Payment — High On Fashion</title>
    <meta name="description" content="Secure payment via Razorpay for your High On Fashion order." />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <GoogleTagManager />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --cream: #f5f1e8;
        --cream-deep: #ebe4d6;
        --forest: #1a2f23;
        --forest-soft: #283a2c;
        --gold: #d4af37;
        --gold-deep: #c49a2a;
        --charcoal: #2d2d2d;
        --muted: #6b6560;
        --line: rgba(26, 47, 35, 0.12);
        --white: #ffffff;
        --success: #2f6b4f;
        --error: #b42318;
        --radius: 2px;
        --shadow: 0 18px 50px rgba(26, 47, 35, 0.08);
      }

      html, body {
        min-height: 100%;
        font-family: "Inter", system-ui, sans-serif;
        background: var(--cream);
        color: var(--charcoal);
        -webkit-font-smoothing: antialiased;
      }

      .page {
        min-height: 100vh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        background:
          radial-gradient(ellipse 70% 45% at 50% -5%, rgba(212, 175, 55, 0.14), transparent 60%),
          linear-gradient(180deg, #faf7f0 0%, var(--cream) 45%, var(--cream-deep) 100%);
      }

      .header {
        display: flex;
        justify-content: center;
        padding: 1.75rem 1.25rem 1.25rem;
      }

      .logo-link {
        display: block;
        width: min(180px, 52vw);
        transition: opacity 0.2s ease;
      }

      .logo-link:hover { opacity: 0.85; }

      .logo-link img {
        width: 100%;
        height: auto;
        display: block;
      }

      .main {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 1rem 2rem;
      }

      .panel {
        width: 100%;
        max-width: 440px;
        background: var(--white);
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .panel-top {
        padding: 1.75rem 1.75rem 1.35rem;
        border-bottom: 1px solid var(--line);
        background:
          linear-gradient(180deg, rgba(26, 47, 35, 0.03), transparent),
          var(--white);
        text-align: center;
      }

      .eyebrow {
        font-size: 0.68rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--gold-deep);
        font-weight: 600;
        margin-bottom: 0.65rem;
      }

      .panel-top h1 {
        font-family: "Playfair Display", serif;
        font-size: clamp(1.55rem, 4vw, 1.85rem);
        font-weight: 600;
        color: var(--forest);
        line-height: 1.2;
        margin-bottom: 0.45rem;
      }

      .panel-top p {
        font-size: 0.88rem;
        color: var(--muted);
        line-height: 1.5;
      }

      .panel-body {
        padding: 1.5rem 1.75rem 1.75rem;
      }

      .summary {
        border: 1px solid var(--line);
        background: rgba(245, 241, 232, 0.55);
      }

      .order-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1rem;
        font-size: 0.86rem;
        color: var(--muted);
        border-bottom: 1px solid var(--line);
      }

      .order-row:last-child { border-bottom: none; }

      .order-row.total {
        background: var(--forest);
        color: var(--white);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .order-row .amount {
        font-variant-numeric: tabular-nums;
        color: var(--charcoal);
        font-weight: 600;
      }

      .order-row.total .amount {
        color: var(--gold);
        font-size: 1.15rem;
        font-family: "Playfair Display", serif;
        font-weight: 600;
      }

      .trust {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        margin: 1.15rem 0 1.35rem;
        padding: 0.85rem 0.95rem;
        border: 1px solid rgba(212, 175, 55, 0.35);
        background: rgba(212, 175, 55, 0.08);
        font-size: 0.78rem;
        line-height: 1.45;
        color: var(--forest-soft);
      }

      .trust svg {
        flex-shrink: 0;
        margin-top: 1px;
        color: var(--gold-deep);
      }

      .btn-pay {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        min-height: 3.15rem;
        padding: 0.9rem 1.25rem;
        border: none;
        background: var(--forest);
        color: var(--white);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn-pay:hover:not(:disabled) {
        background: var(--forest-soft);
        box-shadow: 0 10px 28px rgba(26, 47, 35, 0.22);
        transform: translateY(-1px);
      }

      .btn-pay:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }

      .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.25);
        border-top-color: var(--gold);
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        flex-shrink: 0;
      }

      @keyframes spin { to { transform: rotate(360deg); } }

      .rzp-brand {
        margin-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        color: var(--muted);
      }

      .rzp-brand img {
        height: 14px;
        opacity: 0.7;
      }

      .footer {
        text-align: center;
        padding: 1.25rem 1rem 1.75rem;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .skeleton {
        height: 0.7rem;
        border-radius: 2px;
        background: linear-gradient(90deg, #ebe4d6 25%, #f7f3ea 50%, #ebe4d6 75%);
        background-size: 200% 100%;
        animation: shimmer 1.3s ease infinite;
      }

      @keyframes shimmer { to { background-position: -200% 0; } }

      .overlay-state {
        position: fixed;
        inset: 0;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 2rem 1.25rem;
        text-align: center;
        background:
          radial-gradient(ellipse 60% 40% at 50% 30%, rgba(212, 175, 55, 0.12), transparent 55%),
          var(--cream);
        z-index: 100;
      }

      .overlay-state.visible { display: flex; }

      .overlay-logo {
        width: min(140px, 42vw);
        margin-bottom: 0.5rem;
        opacity: 0.95;
      }

      .overlay-logo img {
        width: 100%;
        height: auto;
        display: block;
      }

      .overlay-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .overlay-icon.loading {
        border: 2px solid rgba(26, 47, 35, 0.12);
        border-top-color: var(--gold);
        animation: spin 0.8s linear infinite;
      }

      .overlay-icon.success {
        background: rgba(47, 107, 79, 0.1);
        color: var(--success);
      }

      .overlay-icon.error {
        background: rgba(180, 35, 24, 0.08);
        color: var(--error);
      }

      .overlay-title {
        font-family: "Playfair Display", serif;
        font-size: 1.55rem;
        color: var(--forest);
        font-weight: 600;
      }

      .overlay-desc {
        max-width: 320px;
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--muted);
      }

      .btn-retry {
        margin-top: 0.35rem;
        padding: 0.75rem 1.5rem;
        border: 1px solid var(--forest);
        background: transparent;
        color: var(--forest);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
      }

      .btn-retry:hover {
        background: var(--forest);
        color: var(--white);
      }

      @media (max-width: 520px) {
        .panel { border-left: none; border-right: none; }
        .panel-top, .panel-body { padding-left: 1.25rem; padding-right: 1.25rem; }
      }
    </style>
  </head>

  <body>
    <GoogleTagManager placement="body" />

    <div class="page">
      <header class="header">
        <a href="/" class="logo-link" aria-label="High On Fashion home">
          <AstroImage src={logo} alt="High On Fashion" widths={[360]} sizes="180px" />
        </a>
      </header>

      <main class="main">
        <div class="panel">
          <div class="panel-top">
            <p class="eyebrow">Secure checkout</p>
            <h1>Complete your order</h1>
            <p>Pay securely with Razorpay to confirm your High On Fashion pieces.</p>
          </div>

          <div class="panel-body">
            <div class="summary" id="order-summary">
              <div class="order-row">
                <span class="skeleton" style="width:110px"></span>
                <span class="skeleton" style="width:64px"></span>
              </div>
              <div class="order-row total">
                <span class="skeleton" style="width:90px; background:#3a4f40"></span>
                <span class="skeleton" style="width:72px; background:#3a4f40"></span>
              </div>
            </div>

            <div class="trust">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>Encrypted payment · Cards, UPI & wallets via Razorpay</span>
            </div>

            <button class="btn-pay" id="btn-pay" disabled>
              <span id="btn-spinner" class="spinner" style="display:none"></span>
              <span id="btn-text">Loading order…</span>
            </button>

            <div class="rzp-brand">
              Powered by
              <img
                src="https://razorpay.com/assets/razorpay-glyph.svg"
                alt=""
                onerror="this.style.display='none'"
              />
              Razorpay
            </div>
          </div>
        </div>
      </main>

      <footer class="footer">© High On Fashion · Secure transaction</footer>
    </div>

    <div class="overlay-state" id="overlay-init">
      <div class="overlay-logo">
        <AstroImage src={logo} alt="High On Fashion" widths={[280]} sizes="140px" />
      </div>
      <div class="overlay-icon loading"></div>
      <p class="overlay-desc">Preparing your checkout…</p>
    </div>

    <div class="overlay-state" id="overlay-processing">
      <div class="overlay-logo">
        <AstroImage src={logo} alt="High On Fashion" widths={[280]} sizes="140px" />
      </div>
      <div class="overlay-icon loading"></div>
      <p class="overlay-title">Confirming payment</p>
      <p class="overlay-desc">Please wait while we verify your payment and update your order.</p>
    </div>

    <div class="overlay-state" id="overlay-success">
      <div class="overlay-logo">
        <AstroImage src={logo} alt="High On Fashion" widths={[280]} sizes="140px" />
      </div>
      <div class="overlay-icon success">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <p class="overlay-title">Payment successful</p>
      <p class="overlay-desc">Your order is confirmed. Redirecting you to your order summary…</p>
    </div>

    <div class="overlay-state" id="overlay-error">
      <div class="overlay-logo">
        <AstroImage src={logo} alt="High On Fashion" widths={[280]} sizes="140px" />
      </div>
      <div class="overlay-icon error">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <p class="overlay-title">Payment failed</p>
      <p class="overlay-desc" id="error-msg">Something went wrong. Please try again.</p>
      <button class="btn-retry" type="button" onclick="window.location.reload()">Try again</button>
    </div>

    <script is:inline define:vars={{ logoSrc }}>
      (async () => {
        const $ = (id) => document.getElementById(id);
        const show = (id) => $(id).classList.add("visible");
        const hide = (id) => $(id).classList.remove("visible");

        function showError(msg) {
          hide("overlay-init");
          hide("overlay-processing");
          $("error-msg").textContent = msg || "Something went wrong. Please try again.";
          show("overlay-error");
        }

        function formatINR(amount) {
          return new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            minimumFractionDigits: 0,
          }).format(amount);
        }

        const params = new URLSearchParams(window.location.search);
        const publicToken = params.get("publicToken");

        if (!publicToken) {
          showError("No payment session found. Please return to the store and try again.");
          return;
        }

        show("overlay-init");

        let orderData;
        try {
          const res = await fetch("/api/create-razorpay-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ publicToken }),
          });

          orderData = await res.json();

          if (!res.ok || !orderData.razorpay_order_id) {
            throw new Error(orderData.error || "Could not create order");
          }
        } catch (err) {
          showError(err.message || "Failed to load order details. Please try again.");
          return;
        }

        hide("overlay-init");

        const summary = $("order-summary");
        summary.innerHTML = `
          <div class="order-row">
            <span>Order total</span>
            <span class="amount">${formatINR(orderData.amount_display)}</span>
          </div>
          <div class="order-row total">
            <span>Amount to pay</span>
            <span class="amount">${formatINR(orderData.amount_display)}</span>
          </div>
        `;

        const btnPay = $("btn-pay");
        const btnText = $("btn-text");
        const btnSpinner = $("btn-spinner");

        btnPay.disabled = false;
        btnText.textContent = `Pay ${formatINR(orderData.amount_display)}`;

        const razorpayLogo = logoSrc.startsWith("http")
          ? logoSrc
          : `${window.location.origin}${logoSrc}`;

        const razorpayOptions = {
          key: orderData.razorpay_key_id,
          amount: orderData.amount,
          currency: orderData.currency,
          order_id: orderData.razorpay_order_id,
          name: "High On Fashion",
          description: "Your High On Fashion order",
          image: razorpayLogo,
          prefill: {
            name: orderData.customer.name || "",
            email: orderData.customer.email || "",
            contact: orderData.customer.phone || "",
          },
          theme: {
            color: "#1A2F23",
            backdrop_color: "rgba(245, 241, 232, 0.92)",
          },
          modal: {
            confirm_close: true,
            ondismiss: () => {
              btnPay.disabled = false;
              btnSpinner.style.display = "none";
              btnText.textContent = `Pay ${formatINR(orderData.amount_display)}`;
            },
          },
          handler: async (response) => {
            show("overlay-processing");
            btnPay.disabled = true;

            try {
              const verifyRes = await fetch("/api/verify-payment", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_signature: response.razorpay_signature,
                  publicToken,
                }),
              });

              const verifyData = await verifyRes.json();

              if (!verifyRes.ok || !verifyData.success) {
                let errMsg = verifyData.error || "Payment verification failed";
                if (verifyData.snipcart_status) {
                  errMsg += ` (Snipcart ${verifyData.snipcart_status}: ${verifyData.snipcart_error || ""})`;
                }
                throw new Error(errMsg);
              }

              hide("overlay-processing");
              show("overlay-success");

              setTimeout(() => {
                window.location.href = verifyData.returnUrl || "/";
              }, 2200);
            } catch (err) {
              hide("overlay-processing");
              showError(
                err.message ||
                  "Your payment was received but we could not confirm your order. Payment ID: " +
                    (response.razorpay_payment_id || "N/A")
              );
            }
          },
        };

        btnPay.addEventListener("click", () => {
          if (btnPay.disabled) return;

          btnPay.disabled = true;
          btnSpinner.style.display = "block";
          btnText.textContent = "Opening payment…";

          requestAnimationFrame(() => {
            try {
              const rzp = new Razorpay(razorpayOptions);
              rzp.open();
            } catch (err) {
              btnPay.disabled = false;
              btnSpinner.style.display = "none";
              btnText.textContent = `Pay ${formatINR(orderData.amount_display)}`;
              showError("Could not open payment modal. Please refresh and try again.");
            }
          });
        });
      })();
    </script>
  </body>
</html>
